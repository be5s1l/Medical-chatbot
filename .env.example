## Copy to `.env` (do not commit `.env`)

# Pick one:
# LLM_PROVIDER=openai
# LLM_PROVIDER=ollama
# LLM_PROVIDER=gemini
# LLM_PROVIDER=groq
LLM_PROVIDER=groq

# OpenAI (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Gemini (only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.0-flash

# Groq (only if LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Vector DB
CHROMA_DB_PATH=./data/chroma_db

# OCR
TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe

# Logging
LOG_LEVEL=DEBUG

# Safety
EMERGENCY_KEYWORDS=chest pain,stroke,unconscious,severe bleeding,can't breathe

# Dev-only
APP_DEBUG=false

