# Choose one:
# - anthropic: calls Anthropic directly from browser (dev only; exposes key)
# - proxy: calls your backend endpoint (recommended)
VITE_CHAT_MODE=proxy

# Proxy mode:
VITE_CHAT_PROXY_URL=http://localhost:8000/chat

# Anthropic mode (dev only):
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

